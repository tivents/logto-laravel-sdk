{
    "name": "tivents/logto-laravel-sdk",
    "description": "Laravel package for Logto authentication and authorization",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "logto",
        "authentication",
        "oidc",
        "oauth2"
    ],
    "authors": [
        {
            "name": "TIVENTS",
            "email": "entwicklung@tivents.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0",
        "guzzlehttp/guzzle": "^7.5",
        "firebase/php-jwt": "^6.0",
        "ext-json": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-mockery": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "TIVENTS\\LogtoLaravelSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TIVENTS\\LogtoLaravelSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TIVENTS\\LogtoLaravelSdk\\LogtoServiceProvider"
            ],
            "aliases": {
                "Logto": "TIVENTS\\LogtoLaravelSdk\\Facades\\Logto"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
